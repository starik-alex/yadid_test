{
  "$description": "Yadid landing design tokens (W3C Design Tokens format). Mirrors public/css/styles.css — tests/static.test.js keeps them in sync.",
  "color": {
    "light": {
      "$type": "color",
      "navy": { "$value": "#0B1F3A", "$description": "Headings, logo — trust, law" },
      "navy-2": { "$value": "#16305A" },
      "brass": { "$value": "#A8834A", "$description": "Accents — history, heritage" },
      "brass-soft": { "$value": "#F1E6D3" },
      "action": { "$value": "#0071E3", "$description": "Only for buttons and the progress bar" },
      "action-hover": { "$value": "#0077ED" },
      "link": { "$value": "#0066CC" },
      "bg": { "$value": "#F5F5F7" },
      "surface": { "$value": "#FFFFFF" },
      "text": { "$value": "#1D1D1F" },
      "text-2": { "$value": "#5E5E63" },
      "border": { "$value": "#D2D2D7" },
      "error": { "$value": "#D70015" },
      "error-bg": { "$value": "#FFF2F3" },
      "success": { "$value": "#1D7A35" }
    },
    "dark": {
      "$type": "color",
      "navy": { "$value": "#DBE5F5" },
      "navy-2": { "$value": "#A9BBD9" },
      "brass": { "$value": "#D3B07A" },
      "brass-soft": { "$value": "#2A2316" },
      "action": { "$value": "#0071E3" },
      "action-hover": { "$value": "#1A82F0" },
      "link": { "$value": "#4AA8FF" },
      "bg": { "$value": "#000000" },
      "surface": { "$value": "#1C1C1E" },
      "text": { "$value": "#F5F5F7" },
      "text-2": { "$value": "#A1A1A6" },
      "border": { "$value": "#3A3A3C" },
      "error": { "$value": "#FF6961" },
      "error-bg": { "$value": "#2C1214" },
      "success": { "$value": "#32D74B" }
    },
    "glass": {
      "$type": "color",
      "light": { "$value": "#FFFFFF9E", "$description": "white @ 62%, background blur 28px, saturate 180%" },
      "light-border": { "$value": "#FFFFFFB3" },
      "dark": { "$value": "#1C1C1E94", "$description": "#1C1C1E @ 58%, background blur 28px" },
      "dark-border": { "$value": "#FFFFFF1F" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["-apple-system", "SF Pro Text", "SF Hebrew", "Heebo", "Segoe UI", "Arial", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "display": { "$value": "68px", "$description": "Desktop; 36px on mobile (clamp in CSS)" },
      "h2": { "$value": "44px", "$description": "28px on mobile" },
      "h3": { "$value": "26px", "$description": "20px on mobile" },
      "lead": { "$value": "22px", "$description": "18px on mobile" },
      "body": { "$value": "17px" },
      "small": { "$value": "15px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "heavy": { "$value": 800 }
    }
  },
  "radius": {
    "$type": "dimension",
    "s": { "$value": "12px", "$description": "Inputs, quiz options" },
    "m": { "$value": "20px", "$description": "Cards" },
    "l": { "$value": "28px", "$description": "Glass panels" },
    "pill": { "$value": "999px", "$description": "Buttons" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "72px" },
    "9": { "$value": "112px" }
  },
  "size": {
    "$type": "dimension",
    "tap": { "$value": "48px", "$description": "Minimum touch target" },
    "container": { "$value": "1080px" },
    "mobile-frame": { "$value": "390px", "$description": "iPhone frame for mobile mockups" }
  }
}
